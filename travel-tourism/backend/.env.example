# Server Port (automatically injected by Render / Railway)
PORT=5000

# Deployed Frontend URL (for CORS security)
CLIENT_URL=https://your-frontend-app.vercel.app

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sih_travel_tourism?retryWrites=true&w=majority

# JWT Security Secret
JWT_SECRET=your_super_secret_jwt_key_here

# External AI & Service API Keys
AI_API_KEY=your_gemini_api_key_here
WEATHER_API_KEY=your_openweathermap_api_key_here
